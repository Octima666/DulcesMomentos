# Configuración de Entorno - Pastelería Dulces Momentos
PORT=3000

# ──────────────────────────────────────────────────────────────
# Base de Datos PostgreSQL (Neon)
# Pasos:
#   1. Entrá a https://neon.tech y creá tu proyecto
#   2. Ir a "Connection Details" → activar "Pooled connection"
#   3. Copiá la "Connection string" y pegala abajo
# ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST.neon.tech/dulces_momentos?sslmode=require

# Seguridad JWT (no cambiar en producción sin actualizar Vercel también)
JWT_SECRET=dulces_momentos_secret_key_2026_super_secure_jwt_token!

# Mercado Pago SDK v2 (reemplazá con tus credenciales reales)
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000
