# Configuración de Entorno - Pastelería Dulces Momentos
PORT=3000

# Base de Datos PostgreSQL
# Para desarrollo local: instalar PostgreSQL y crear la base de datos
# DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/dulces_momentos
#
# Para producción en Render: copiar la "Internal Database URL" desde el dashboard de Render
DATABASE_URL=postgresql://usuario:password@host:5432/dulces_momentos

# Seguridad JWT (cambiar por una clave larga y aleatoria en producción)
JWT_SECRET=dulces_momentos_secret_key_2026_super_secure_jwt_token!

# Mercado Pago SDK v2 (reemplaza con tus credenciales reales)
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000
